# ==========================================
# DocuVerse AI - Environment Variables Template
# ==========================================
# Copy this file as ".env" and set your variables:

# 1. Groq Cloud API Key (Required for LLM inference)
# Get your free key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. FastAPI Backend Server Settings
PORT=8000
MAX_FILE_SIZE_MB=15
CORS_ORIGINS=*

# 3. Streamlit Frontend Backend Connection URL
# For local dev: http://127.0.0.1:8000
# For production: https://docuverse-api.onrender.com
BACKEND_URL=http://127.0.0.1:8000
